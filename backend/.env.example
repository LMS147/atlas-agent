# Copy to .env and fill in. Never commit .env.
TELEGRAM_TOKEN=123456:ABC...
GROQ_API_KEY=gsk_...
ALLOWED_USER_IDS=123456789
MODEL=llama-3.3-70b-versatile
DATA_DIR=./data

# --- Free-tier extras (leave unset for the normal disk-backed deploy) ---
# GitHub-backed memory instead of local files:
# GH_REPO=yourname/agent-memory
# GH_TOKEN=github_pat_...          # fine-grained PAT, Contents: read+write
# Webhook mode secret (Render web service):
# WEBHOOK_SECRET=any-long-random-string

