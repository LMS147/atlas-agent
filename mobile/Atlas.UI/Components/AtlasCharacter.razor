@implements IAsyncDisposable
@inject IServiceProvider Services
<div class="atlas-character @(Compact ? "compact" : "") @(Portrait ? "portrait" : "")">
    <div class="atlas-stage @(ready ? "renderer-ready" : "portrait-fallback")" @ref="stage">
        <canvas hidden="@(!ready)" @ref="canvas" tabindex="0" role="img" aria-label="Interactive 3D Atlas. Drag or use left and right arrows to turn him."></canvas>
        <img hidden="@ready" class="character-fallback" src="_content/Atlas.UI/atlas/mascot.webp" alt="Atlas AI companion" />

    </div>
    <div class="character-state"><span class="status-dot"></span>@(State.Speaking?"Speaking":State.Busy?"Working with you":ready?"3D companion":"Portrait mode")</div>
    @if(!Compact && ready){<div class="character-controls"><button disabled="@(!ready)" @onclick="Wave">Wave</button><button disabled="@(!ready)" @onclick="Reset">Reset view</button></div>}
    @if(failed && !Compact){<details class="context-help"><summary>About portrait mode</summary><p>The 3D renderer is unavailable. Atlas’s original portrait is shown; voice remains available if supported by your device.</p></details>}
</div>
@code {
    [Parameter] public bool Compact {get;set;}
    [Parameter] public bool Portrait {get;set;}
    [Parameter] public bool Visible {get;set;} = true;
    private DotNetObjectReference<AtlasCharacter>? reference;
    private ElementReference canvas,stage;
    private IJSObjectReference? module,character;
    private bool ready,failed,disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(disposed || failed)return;
        try
        {
            if(firstRender)
            {
                var js=Services.GetService(typeof(IJSRuntime)) as IJSRuntime ?? throw new InvalidOperationException("JavaScript is unavailable.");
                module=await js.InvokeAsync<IJSObjectReference>("import","./_content/Atlas.UI/atlas-3d.js");
                if(disposed){await module.DisposeAsync();module=null;return;}
                reference=DotNetObjectReference.Create(this);
                character=await module.InvokeAsync<IJSObjectReference>("createAtlas",canvas,stage,reference);
                if(disposed){await character.InvokeVoidAsync("dispose");await character.DisposeAsync();character=null;await module.DisposeAsync();module=null;return;}
                ready=true;await InvokeAsync(StateHasChanged);
            }
            if(character is not null)
            {
                await character.InvokeVoidAsync("setPortrait",Portrait);
                await character.InvokeVoidAsync("setState",State.Speaking?"speaking":State.Busy?"thinking":"idle",State.IsActive && Visible);
            }
        }
        catch(JSException){failed=true;ready=false;await InvokeAsync(StateHasChanged);}
        catch(InvalidOperationException){failed=true;ready=false;await InvokeAsync(StateHasChanged);}
    }
    [JSInvokable] public Task RendererLost(){failed=true;ready=false;return InvokeAsync(StateHasChanged);}
    private async Task Wave(){if(character is not null)await character.InvokeVoidAsync("wave");}
    private async Task Reset(){if(character is not null)await character.InvokeVoidAsync("reset");}
    public async ValueTask DisposeAsync()
    {
        disposed=true;
        reference?.Dispose();
        try{if(character is not null){await character.InvokeVoidAsync("dispose");await character.DisposeAsync();}if(module is not null)await module.DisposeAsync();}
        catch(JSException){}
        catch(InvalidOperationException){}
    }
}
