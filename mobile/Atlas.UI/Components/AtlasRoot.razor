@inherits ComponentBase
@inject AppState State
@implements IDisposable
<CascadingValue Value="State" IsFixed="false">
<div class="app-shell @(State.Connected ? "connected" : "welcome")">
    <header class="app-header">
        <div class="brand"><span class="brand-mark">A<span class="brand-dot"></span></span><div><strong>Atlas<span class="brand-ai"> AI</span></strong><small>Your personal workspace</small></div></div>
        <span class="connection-status @(State.Connected ? State.Repo.Offline ? "offline" : "online" : "")"><span class="status-dot"></span>@(State.Connected ? State.Repo.Offline ? "Offline cache" : "Connected" : "Private by design")</span>
    </header>
    @if(State.Connected)
    {
        <nav class="navigation" aria-label="Main navigation">
            <span class="nav-caption">WORKSPACE</span>
            @foreach(var page in pages)
            {
                <button class="@(State.Page==page ? "active" : "")" disabled="@State.Busy" aria-current="@(State.Page==page ? "page" : null)" @onclick="()=>Navigate(page)"><AtlasIcon Name="@PageIcon(page)" /><span>@(page)</span></button>
            }
            <div class="nav-footer"><AtlasIcon Name="lock" /><span>Your server.<br />Your conversations.</span></div>
        </nav>
    }
    <main>
        @if(State.Busy){<div class="loading" role="status">Working…</div>}
        @if(State.Error is not null){<div class="alert error" role="alert">@State.Error</div>}
        @if(State.Notice is not null){<div class="alert notice" role="status">@State.Notice</div>}
        @if(!State.Connected || State.Page=="Setup"){<Setup />}
        else
        {
            @switch(State.Page)
            {
                case "Chat":<Chat />break;
                case "Conversations":<Conversations />break;
                case "Memory":<Memory />break;
                case "Files":<Files />break;
                case "Monitoring":<Monitoring />break;
                case "Profile":<ProfilePage />break;
                case "Settings":<Settings />break;
            }
        }
    </main>
</div>
</CascadingValue>
@code {
    private readonly string[] pages=["Chat","Conversations","Memory","Files","Monitoring","Profile","Settings"];
    protected override async Task OnInitializedAsync(){State.Changed+=OnChanged;await State.InitializeAsync();}
    private void OnChanged()=>_ = InvokeAsync(StateHasChanged);
    private Task Navigate(string page)=>State.NavigateAsync(page);
    private static string PageIcon(string page)=>page switch {"Chat"=>"chat","Conversations"=>"history","Memory"=>"memory","Files"=>"files","Monitoring"=>"monitor","Profile"=>"profile",_=>"settings"};
    public void Dispose()=>State.Changed-=OnChanged;
}
