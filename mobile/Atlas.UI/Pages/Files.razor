@implements IDisposable
<section class="page files-page"><div class="page-heading"><div><span class="eyebrow">WORKSPACE DOCUMENTS</span><h1>Files</h1></div><button class="primary" disabled="@State.Busy" @onclick="Pick"><AtlasIcon Name="plus" /> Upload</button></div>
<div class="file-location"><nav class="breadcrumbs" aria-label="File location"><button disabled="@State.Busy" @onclick="Root">Server files</button>@foreach(var crumb in Breadcrumbs){<span aria-hidden="true">/</span><button disabled="@State.Busy" @onclick="()=>Load(crumb.Path)">@crumb.Name</button>}</nav><button aria-label="Refresh folder" disabled="@State.Busy" @onclick="()=>Load(directory)"><AtlasIcon Name="refresh" /></button></div>
<details class="context-help"><summary>File permissions and transfer limits</summary><p>Upload files to workspace. Canonical documents and backups are read-only. Transfers support files up to 5 MiB; text editing supports UTF-8 documents up to 256 KiB.</p></details>
@if(State.Busy){<p role="status" class="field-hint">@transferStatus</p>}
<div class="file-list">
@foreach(var item in rows)
{
    <article class="file-row" @key="item.Path"><AtlasIcon Name="@(item.Directory?"files":"document")" /><div class="file-info"><button class="file-name" disabled="@State.Busy" @onclick="()=>Open(item)">@item.Name</button><small class="muted">@(item.Directory?"Folder":$"{item.SizeBytes:N0} bytes · {(item.Writable?"Editable":"Read-only")}")</small></div>@if(!item.Directory){<details class="file-actions"><summary aria-label="@($"Actions for {item.Name}")">•••</summary><button disabled="@State.Busy" @onclick="()=>Open(item)">View text</button><button disabled="@State.Busy" @onclick="()=>Download(item)">Download / open</button></details>}</article>
}
</div>
@if(rows.Count==0 && !State.Busy && State.Error is null){<div class="empty-state"><AtlasIcon Name="files" /><h2>This folder is empty</h2><p>Use Upload to add a file to your workspace.</p></div>}
@if(upload is not null){<div class="dialog-backdrop"><section class="dialog form-grid" role="dialog" aria-modal="true" aria-label="Upload file"><h2>Upload to workspace</h2>@if(State.Busy){<progress aria-label="Uploading file"></progress><p role="status">Uploading…</p>}<p>Files up to 5 MiB. Choose an unused filename. Use letters/numbers, spaces, dots, dashes or underscores; begin with a letter or number.</p><input @bind="name" maxlength="120" aria-label="Upload filename" />
@if(State.Error is not null){<p class="error">@State.Error</p>}
<div class="toolbar"><button disabled="@State.Busy" @onclick="Upload">Upload</button><button disabled="@State.Busy" @onclick="()=>upload=null">Cancel</button></div></section></div>}
@if(document is not null){<div class="dialog-backdrop"><section class="dialog editor" role="dialog" aria-modal="true" aria-label="File editor"><h2>@document.Path</h2><p class="field-hint">UTF-8 text · editor limit 256 KiB</p><p class="muted">@(document.Writable?"Editable UTF-8 document":"Read-only document")</p>
@if(State.Error is not null){<p class="error">@State.Error</p>}
<textarea @bind="content" @bind:event="oninput" readonly="@(!document.Writable)" disabled="@State.Busy" aria-label="Document content" maxlength="262144"></textarea><div class="toolbar"><button disabled="@State.Busy" @onclick="Close">Close</button>@if(document.Writable){<button class="primary" disabled="@(State.Busy || content==document.Content)" @onclick="Save">Save</button>}</div></section></div>}
</section>
@code {
    private string transferStatus="Loading files…";
    private IEnumerable<(string Name,string Path)> Breadcrumbs { get { var path=""; foreach(var part in directory.Split('/',StringSplitOptions.RemoveEmptyEntries)){path=path.Length==0?part:path+"/"+part;yield return(part,path);} } }
    private List<FileItem> rows=[];private string directory="",content="",name="";private FileDocument? document;private (string Name,byte[] Content)? upload;
    protected override Task OnInitializedAsync(){State.BackHandler=Back;return Load("");}
    private async Task<bool> Back()
    {
        if(document is not null){await Close();await InvokeAsync(StateHasChanged);return true;}
        if(upload is not null){upload=null;await InvokeAsync(StateHasChanged);return true;}
        return false;
    }
    public void Dispose(){State.BackHandler=null;}
    private Task Root()=>Load("");
    private Task Load(string folder)=>State.Run(async()=>{transferStatus="Loading files…";var result=await State.Repo.FilesAsync(folder);rows=result;directory=folder;});
    private async Task Open(FileItem item){if(item.Directory)await Load(item.Path);else await State.Run(async()=>{document=await State.Repo.DocumentAsync(item.Path);content=document.Content;});}
    private Task Pick()=>State.Run(async()=>{upload=await State.DeviceFiles.PickAsync();if(upload is not null)name=upload.Value.Name;});
    private Task Upload()=>State.Run(async()=>
    {
        if(!System.Text.RegularExpressions.Regex.IsMatch(name,"^[A-Za-z0-9][A-Za-z0-9._ -]{0,119}$"))throw new ArgumentException("Enter a valid workspace filename (120 characters maximum).");
        transferStatus="Uploading file… Please keep the app open.";State.Notify();
        await State.Repo.UploadAsync(name,upload!.Value.Content);upload=null;directory="workspace";rows=await State.Repo.FilesAsync(directory);State.Success("File uploaded.");
    });
    private Task Download(FileItem item)=>State.Run(async()=>{transferStatus="Downloading file…";State.Notify();var bytes=await State.Repo.DownloadAsync(item.Path);await State.DeviceFiles.SaveAsync(item.Name,bytes);State.Success("Choose your destination or an app in the system share/open menu.");});
    private Task Save()=>State.Run(async()=>{await State.Repo.EditFileAsync(document!,content);document=await State.Repo.DocumentAsync(document!.Path);content=document.Content;State.Success("File saved.");});
    private async Task Close(){if(content!=document!.Content && !await State.DeviceFiles.ConfirmAsync("Discard changes?","Your unsaved text edits will be discarded."))return;document=null;}
}
