<section class="page"><span class="eyebrow">YOUR WORKSPACE</span><h1>Tools</h1><p class="muted">Quick access to the tools connected to your Atlas server.</p>
<div class="tools-grid">
@foreach(var tool in tools){<button disabled="@State.Busy" @onclick="()=>State.NavigateAsync(tool.Page)"><AtlasIcon Name="@tool.Icon" /><strong>@tool.Title</strong><span>@tool.Description</span></button>}
</div></section>
@code {
    private readonly (string Page,string Icon,string Title,string Description)[] tools=[("Files","files","File manager","Open, upload, and edit workspace files"),("Memory","memory","Memory manager","Manage what Atlas remembers"),("Monitoring","server","Server status","CPU, memory, storage, and service metrics"),("Atlas","spark","Atlas companion","Open your live 3D companion")];
}
