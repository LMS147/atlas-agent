<section class="chat-page page">
    <div class="page-heading"><div><span class="eyebrow">YOUR SPACE TO THINK</span><h1>@(State.Repo.Current?.Title ?? "Choose a conversation")</h1></div><button disabled="@State.Busy" @onclick="NewChat"><AtlasIcon Name="plus" /> New chat</button></div>
    @if(State.Repo.Current?.ServerAvailable==false){<div class="alert">This chat is cached locally and unavailable on this server. Its cached messages are preserved.</div>}
    <div class="toolbar">
        <button disabled="@(State.Busy || State.Repo.Current?.ServerAvailable!=true)" @onclick="()=>State.Run(()=>State.Repo.HistoryAsync())">Refresh history</button>
        @if(State.Repo.Current?.HasMore==true){<button disabled="@State.Busy" @onclick="()=>State.Run(()=>State.Repo.HistoryAsync(true))">Load earlier</button>}
    </div>
    @if(State.Repo.Messages.Any())
    {
        <div class="chat-companion-dock"><AtlasCharacter Compact="true" Portrait="true" /><div><strong>Atlas</strong><p>@(State.Speaking?"Speaking with you":State.Busy?"Working with you…":"Ready when you are.")</p>@if(State.Speaking){<button @onclick="State.StopSpeaking">Stop voice</button>}else{<button disabled="@State.Busy" @onclick='()=>State.NavigateAsync("Atlas")'>Open companion</button>}</div></div>
    }
    <div class="messages" role="log" aria-label="Conversation messages">
        @if(!State.Repo.Messages.Any()){<div class="empty chat-welcome"><AtlasCharacter Compact="true" /><span class="eyebrow">A FRESH START</span><h2>What’s on your mind?</h2><p>Bring a question, an idea, or a task.<br />Let’s work through it together.</p><div class="starter-grid"><button disabled="@State.Busy" @onclick='()=>draft="Help me turn an idea into a clear plan."'><AtlasIcon Name="spark" /><strong>Explore an idea</strong><span>Find a useful starting point</span></button><button disabled="@State.Busy" @onclick='()=>draft="Help me prioritize my tasks and make a plan for today."'><AtlasIcon Name="memory" /><strong>Make a plan</strong><span>Turn your next steps into action</span></button></div></div>}
        @foreach(var message in State.Repo.Messages)
        {
            <article @key="message.Id" class="message @message.Role">
                <div class="bubble">@if(message.Role!="user"){<img class="atlas-avatar message-avatar" src="_content/Atlas.UI/atlas/avatar.webp" alt="" width="28" height="28" />}<small>@(message.Role=="user"?"You":"Atlas")</small><MessageContent Text="@message.Text" /></div>
                @if(message.Role=="assistant"){<button class="voice-reply" aria-label="Read this reply aloud" disabled="@(!State.SpeechAvailable || State.Speaking || !State.IsActive)" @onclick="()=>State.SpeakAsync(message.Text)"><AtlasIcon Name="voice" /> Read aloud</button>}
                @if(timestamps){<small class="muted">@DateTimeOffset.FromUnixTimeMilliseconds(message.CreatedAt).ToLocalTime().ToString("HH:mm")</small>}
                @if(message.Role=="user" && message.Delivery!=Delivery.Sent)
                {
                    <div class="delivery"><small>@message.Delivery</small><p>@message.Error</p>
                        @if(message.Delivery is Delivery.Recoverable or Delivery.NotReceived){<button disabled="@State.Busy" @onclick="()=>State.Run(()=>State.Repo.RecoverAsync(message.Id))">Check for reply</button>}
                        @if(message.Delivery==Delivery.NotReceived){<button disabled="@State.Busy" @onclick="()=>Retry(message.Id,false)">Retry delivery…</button>}
                        @if(message.Delivery==Delivery.Failed){<button disabled="@State.Busy" @onclick="()=>Retry(message.Id,true)">Send again…</button>}
                    </div>
                }
            </article>
        }
        @if(State.Repo.StreamPhase!="" && State.Repo.Messages.Any(x=>x.Delivery==Delivery.Pending))
        {
            <article class="message assistant streaming-reply" aria-label="Reply in progress"><div class="bubble"><small>Atlas · @(State.Repo.StreamPhase=="thinking"?"Thinking":"Replying")</small>
            @if(State.Repo.StreamText.Length>0){<MessageContent Text="@State.Repo.StreamText" />}else{<p>Preparing your reply…</p>}
            <small class="muted">In progress · confirmed when saved</small></div></article>
        }
    </div>
    @if(State.Speaking){<div class="speech-status" role="status">Atlas is speaking <button @onclick="State.StopSpeaking">Stop voice</button></div>}
    @if(State.Busy && State.Repo.Messages.Any(x=>x.Delivery==Delivery.Pending)){<div class="chat-processing" role="status" aria-live="polite"><strong>@(State.Repo.StreamPhase=="replying"?"Atlas is replying…":"Atlas is preparing your reply…")</strong><span>You can leave the app. Check for the saved reply if the connection is interrupted.</span></div>}
    <form class="composer" @onsubmit="Send" @onsubmit:preventDefault>
        <textarea @bind="draft" @bind:event="oninput" rows="2" maxlength="8000" placeholder="Ask Atlas anything…" aria-label="Message" disabled="@State.Busy"></textarea>
        <button class="primary" type="submit" aria-label="Send message" disabled="@(State.Busy || string.IsNullOrWhiteSpace(draft) || State.Repo.Current?.ServerAvailable!=true || Unresolved)"><span>Send</span><AtlasIcon Name="send" /></button>
    </form>
    <small class="muted composer-note">@(Unresolved?"Check the previous delivery before sending another message.":"AI replies may contain mistakes.")</small>
    <label class="check timestamp-option"><input type="checkbox" @bind="timestamps" /> Show timestamps</label>
</section>
@code {
    private string draft="";private bool timestamps=true;
    private bool Unresolved=>State.Repo.Messages.Any(x=>x.Role=="user" && x.Delivery is Delivery.Pending or Delivery.Recoverable or Delivery.NotReceived);
    private Task NewChat()=>State.Run(()=>State.Repo.NewConversationAsync());
    private async Task Send()
    {
        var submitted=draft;var before=State.Repo.Messages.Select(x=>x.Id).ToHashSet();
        await State.Run(async()=>{await State.Repo.SendAsync(submitted);draft="";});
        // A saved failed bubble retains its text, while an unsaved draft stays editable.
        if(State.Repo.Messages.Any(x=>x.Role=="user" && !before.Contains(x.Id)))draft="";
    }
    private async Task Retry(string id,bool fresh)
    {
        var explanation=fresh?"This creates a NEW AI request and may repeat tool effects. Check saved memories first. Send again?":"This retries delivery with the SAME request ID. A request already received by Atlas will not run again. Retry delivery?";
        if(await State.DeviceFiles.ConfirmAsync("Confirm resend",explanation))await State.Run(()=>State.Repo.RetryAsync(id,fresh));
    }
}
