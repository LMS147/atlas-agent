<section class="page companion-page">
    <h1>Atlas</h1>
    <p class="muted">Your AI companion.</p>
    <AtlasOrb Visible="@Active" />
    <div class="companion-actions">
        <button class="primary" disabled="@(!State.SpeechAvailable || State.SpeechBusy || !State.IsActive)" @onclick="Hello">Say hello</button>
        <button disabled="@(!State.SpeechAvailable || State.SpeechBusy || LatestReply is null || !State.IsActive)" @onclick="ReadLatest">Read latest reply</button>
        @if(State.SpeechBusy){<button class="danger" @onclick="State.StopSpeaking">Stop voice</button>}
    </div>
    <p class="companion-note muted">Voice uses your device’s text-to-speech settings and only plays when you ask.</p>
</section>
@code {
    [Parameter] public bool Active {get;set;} = true;
    private string? LatestReply=>State.Repo.Messages.LastOrDefault(x=>x.Role=="assistant")?.Text;
    private Task Hello()=>State.SpeakAsync("Hello. I'm Atlas, your personal AI companion. Bring me an idea, a question, or a challenge. Let's make something meaningful together.");
    private Task ReadLatest()=>LatestReply is null?Task.CompletedTask:State.SpeakAsync(LatestReply);
}
